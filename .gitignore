# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent/plugin tooling (never part of the app)
/.agents/
/.claude/settings.local.json

# mobile (Capacitor) build output - regenerated by npm run build:mobile
/.next-mobile/
/out/

# safety net for scripts/build-mobile.mjs - app/api should never actually
# land here in a commit; see that script's restore-on-crash logic
/app/_api_offline/

# Android native project: android/ itself IS committed (custom manifest,
# ShareTargetPlugin.java, gradle signing config wiring aren't regenerated by
# `cap sync`) - only build output and machine-local/secret files are ignored.
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/captures/
/android/keystore.properties
*.jks
*.keystore
