# Copy this file to keystore.properties (same directory) and fill in your
# real values. keystore.properties is gitignored - never commit it or the
# .jks file. See the deployment guide for how to generate the keystore
# itself with `keytool -genkeypair`.
storeFile=C:/keys/linkguard-upload.jks
storePassword=
keyAlias=linkguard
keyPassword=
