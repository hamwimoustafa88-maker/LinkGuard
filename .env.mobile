# Public config for the mobile (Capacitor) build ONLY - deliberately named
# .env.mobile, not .env.production: Next.js auto-loads *.production for
# every production build (including the plain web `next build`), which
# would otherwise prefix the web app's own same-origin /api/* calls with
# this URL too. scripts/build-mobile.mjs parses this file manually and
# injects it only into the mobile build's child process env.
#
# Not secret - this is the hosted backend's public URL, committed so
# `npm run build:mobile` works out of the box. Replace with the real
# deployment URL before building a release the app will actually ship in.
NEXT_PUBLIC_API_BASE=https://linkguard.scouthub.dev
NEXT_PUBLIC_SITE_ORIGIN=https://linkguard.scouthub.dev
