# LinkGuard environment variables
# Every key below is OPTIONAL. LinkGuard degrades gracefully: any source whose
# key is missing is skipped, contributes no evidence, and lowers the overall
# confidence score instead of breaking the scan.

# VirusTotal v3 — https://www.virustotal.com/gui/join-us (free tier: 4 req/min, 500/day)
VIRUSTOTAL_API_KEY=

# urlscan.io — https://urlscan.io/user/signup (free tier: limited public scans/day)
URLSCAN_API_KEY=

# unshorten.me — https://unshorten.me/api (free tier; used only as a fallback,
# LinkGuard resolves redirects itself via /api/resolve)
UNSHORTEN_API_KEY=

# Google Safe Browsing v4 — https://developers.google.com/safe-browsing/v4/get-started
# (Google Cloud Console, enable "Safe Browsing API", free tier: 10,000 lookups/day)
GOOGLE_SAFE_BROWSING_API_KEY=

# URLhaus (abuse.ch) — https://urlhaus.abuse.ch/api/ (free Auth-Key, requires account)
URLHAUS_AUTH_KEY=

# PhishTank — https://www.phishtank.com/api_register.php (free app key; registration
# is frequently closed — LinkGuard works without it, just skips this source)
PHISHTANK_APP_KEY=

# AbuseIPDB — https://www.abuseipdb.com/register (free tier: 1,000 checks/day)
ABUSEIPDB_API_KEY=

# Optional: restricts the per-service detail (error text, latency, which
# optional keys are configured) that /api/health and the public /status page
# reveal to anonymous visitors. Leave unset for the default — /status is
# fully public, as advertised. Set this to require the same value (as an
# 'x-health-token' request header) for full detail; anonymous requests still
# get an aggregate online/offline reading. Visit /status?token=<value> to see
# full detail on the status page itself.
HEALTH_TOKEN=
